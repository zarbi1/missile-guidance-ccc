    "paintutils",
    "parallel",
    "peripheral",
    "pocket",
    "rednet",
    "redstone",
    "rs",
    "settings",
    "shell",
    "term",
    "textutils",
    "turtle",
    "vector",
    "window",
    "sleep",
    "write",
    "printError",
    "read",
    "require",
    "_ENV",
    "_G",
    "GYRO",
    "PITCH",
    "ROLL",
    "MONITOR",

{
  "Lua.runtime.version": "LuaJIT",
  "Lua.runtime.path": [
    "?.lua",
    "?/init.lua",
    "v1/?.lua",
    "v1/?/init.lua",
    "v1/ui/?.lua",
    "v1/logic/?.lua",
    "?/?.lua"
  ],
  "Lua.workspace.library": [
    "${workspaceFolder}/.vscode/library"
  ],
  "Lua.workspace.ignoreDir": [
    "/*",
    "!${workspaceFolder}/**"
  ],
  "Lua.workspace.checkThirdParty": false,
